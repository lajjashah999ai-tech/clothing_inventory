{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "buildCommand": "chmod +x build_files.sh && ./build_files.sh",
  "env": {
    "DJANGO_SETTINGS_MODULE": "vastradhaga.settings.production"
  }
}
